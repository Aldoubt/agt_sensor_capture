<?xml version="1.0"?>
<package format="3">
  <name>agt_capture_bringup</name>
  <version>0.1.0</version>
  <description>Unified ROS 2 launch and rosbag2 recording for AGT sensor capture.</description>
  <maintainer email="xuanyang.robotics@gmail.com">Xuan Yang</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>agt_hik_camera_driver</exec_depend>
  <exec_depend>agt_g70_driver</exec_depend>
  <exec_depend>agt_capture_monitor</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
